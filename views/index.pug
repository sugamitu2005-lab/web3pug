doctype html
html
  head
    meta(charset="utf-8")
    title= title
  body
    h1 アンケートフォーム

    form(action="/submit" method="POST")
      label お名前:
      input(type="text" name="name" required)
      br

      label 好きな食べ物:
      select(name="food")
        option(value="ごはん") ごはん
        option(value="パン") パン
        option(value="ラーメン") ラーメン
        option(value="カレー") カレー
      br

      button(type="submit") 送信
