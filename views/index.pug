doctype html
html
  head
    meta(charset="utf-8")
    title= title
    link(rel="stylesheet" href="/style.css")
  body
    h1 アンケートフォーム

    if error
      p(style="color:red") #{error}

    form(action="/submit" method="POST")
      label お名前:
      input(type="text" name="name")
      br

      label 好きな食べ物:
      select(name="food")
        option(value="") --選択してください--
        option(value="ごはん") ごはん
        option(value="パン") パン
        option(value="ラーメン") ラーメン
        option(value="カレー") カレー
      br

      button(type="submit") 送信

    br
    a(href="/list") 回答一覧を見る
