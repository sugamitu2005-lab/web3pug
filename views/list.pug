doctype html
html
  head
    meta(charset="utf-8")
    title 回答一覧
    link(rel="stylesheet" href="/style.css")
  body
    h1 回答一覧

    if answers.length === 0
      p まだ回答がありません。
    else
      ul
        each item in answers
          li #{item.name} さん → #{item.food}

    br
    a(href="/") フォームへ戻る
